{
  "name": "audit-tests",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "coverage": "NODE_OPTIONS=\"--max-old-space-size=8192\" SOLIDITY_COVERAGE=true npx hardhat coverage",
    "clean": "rimraf abi artifacts build cache generated lib/generated typechain-types",
    "test": "hardhat typechain && hardhat test",
    "compile": "hardhat compile",
    "start:local": "hardhat node",
    "contracts:deploy:localhost": "hardhat run ./scripts/deploy.ts  --network localhost",
    "contracts:deploy:local": "hardhat run ./scripts/deploy.ts  --network local",
    "contracts:deploy:hardhat": "hardhat run ./scripts/deploy.ts  --network hardhat",
    "contracts:deploy:polygonMainnet": "hardhat run ./scripts/deploy.ts  --network polygonMainnet",
    "contracts:deploy:mantleMainnet": "hardhat run ./scripts/deploy.ts  --network mantleMainnet",
    "contracts:deploy:baseSepoliaTestnet": "hardhat run ./scripts/deploy.ts  --network baseSepoliaTestnet",
    "contracts:deploy:monadTestnet": "hardhat run ./scripts/deploy.ts  --network monadTestnet",
    "contracts:deploy:bnbMainnet": "hardhat run ./scripts/deploy.ts  --network bnbMainnet",
    "contracts:verify:mantleMainnet": "hardhat run ./scripts/verify.ts --network mantleMainnet",
    "contracts:verify:sourcify": "hardhat run ./scripts/verify-sourcify.ts --network mantleMainnet",
    "start": "docker-compose up",
    "stop": "docker-compose down",
    "graph:codegen": "graph codegen ./subgraph/subgraph.yaml",
    "graph:build": "graph build ./subgraph/subgraph.yaml",
    "graph:remove:local": "graph remove local/local --node http://127.0.0.1:8020",
    "graph:create:local": "graph create local/local --node http://127.0.0.1:8020",
    "graph:deploy:local": "graph deploy local/local --ipfs http://localhost:5001 --node http://127.0.0.1:8020 --version-label 0.0.1 ./subgraph/subgraph.yaml",
    "graph:all:local": "npm run graph:codegen && npm run graph:build && npm run graph:create:local && npm run graph:deploy:local"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": ">=18.0.0",
    "chai": "^4.2.0",
    "ethers": "^6.4.0",
    "hardhat": "^2.24.3",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.0",
    "ts-node": ">=8.0.0",
    "typechain": "^8.3.0",
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "^0.69.1",
    "@graphprotocol/graph-ts": "^0.38.1",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@uniswap/permit2-sdk": "^1.4.0",
    "dotenv": "^17.0.1",
    "solmate": "^6.8.0",
    "web3": "1.10.0"
  }
}
