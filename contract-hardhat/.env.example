# -----------------------------------------------------------------------------
# STF Hardhat workspace — environment template
# Copy to .env in this directory. Hardhat throws if .env is missing.
# Never commit .env or real private keys.
# -----------------------------------------------------------------------------

# --- Deployment config (upgrade-contracts.ts uses the chain/RPC/owner subset) -

# Target chain id. Must match the Hardhat --network you pass.
#   10143  Monad testnet (primary STF testnet)
#   1337   Hardhat / localhost
#   31337  hardhat "local" network
#   84532  Base Sepolia
#   56     BNB mainnet
#   137    Polygon mainnet
#   5000   Mantle mainnet
CHAIN_ID=10143

# JSON-RPC endpoint used by remote Hardhat networks and by deploy.ts (web3 provider).
# Monad public RPC example; Alchemy/Infura URLs also work.
PROVIDER_URL=https://testnet-rpc.monad.xyz

# Existing Permit2 deployment on the SAME chain selected by --network.
# deploy.ts validates that contract code exists here, skips Permit2 deployment,
# and registers this address as Permit2Contract in PolymathRegistry.
# Canonical Uniswap Permit2 on Monad testnet:
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Deployer account. OWNER_ADDRESS must be the address of OWNER_PRIVATE_KEY.
# Local Hardhat account #0 (public well-known key — local/dev only):
#   OWNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
#   OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OWNER_ADDRESS=
OWNER_PRIVATE_KEY=

# --- Optional: explorers / forking -------------------------------------------

# Hardhat etherscan plugin is currently disabled (etherscan.enabled = false).
# Sourcify is used for Monad instead. Safe to leave blank.
ETHERSCAN_API_KEY=

# Fork the in-process hardhat network for tests. Ignored when SOLIDITY_COVERAGE=true.
# FORK_URL=https://monad-testnet.g.alchemy.com/v2/your-key
# FORK_BLOCK=63040980
FORK_URL=
FORK_BLOCK=

# --- Optional: tests / coverage ----------------------------------------------

# Set automatically by `yarn coverage`. Do not set by hand unless debugging coverage.
# SOLIDITY_COVERAGE=true
SOLIDITY_COVERAGE=

# Legacy coverage flag used by some tests to lower gas price.
# COVERAGE=true
COVERAGE=false

# Dividend mass-holder stress test (test/z_mass_dividend_stress.spec.ts)
# MASS_HOLDERS=100
# GENERATION_MNEMONIC=test test test test test test test test test test test junk
# GENERATION_OFFSET=1000
MASS_HOLDERS=
GENERATION_MNEMONIC=
GENERATION_OFFSET=
